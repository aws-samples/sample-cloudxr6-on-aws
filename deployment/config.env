# CloudXR 6 on AWS — Deployment Configuration
# Fill this out before running any commands. Both the AMI build and infrastructure
# deployment read from this file — configure once, everything stays consistent.

# GPU compute location — AZ or Local Zone where GPU instances will run.
# The parent region is derived automatically (e.g., us-west-2 from us-west-2-lax-1b).
# All non-GPU resources (proxy, ALB, auth, registry) deploy in the parent region.
GPU_ZONE=us-west-2-lax-1b

# GPU instance type — must be available in GPU_ZONE.
GPU_TYPE=g7e.8xlarge

# Proxy domain (must match your ACM certificate and Route 53 hosted zone)
DOMAIN=cloudxr.example.com

# Route 53 hosted zone ID for your domain
HOSTED_ZONE_ID=Z0123456789ABCDEFGHIJ

# ACM certificate ARN for CloudFront (must be in us-east-1) — covers DOMAIN
CERT_ARN=arn:aws:acm:us-east-1:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ACM certificate ARN in the DEPLOYMENT region, for the ALB's HTTPS listeners (443 and 48322).
# Must be valid for origin.<DOMAIN>, for two independent reasons: CloudFront validates the
# origin certificate against the hostname it connects to, and Apple native clients connect to
# origin.<DOMAIN> directly on 48322 and validate it against the system trust store.
CERT_ARN_REGIONAL=arn:aws:acm:us-west-2:123456789012:certificate/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# GPU fleet size
WEBRTC_POOL_SIZE=1
NATIVE_POOL_SIZE=0

# Golden AMI. This default is the published g7e 1-GPU AMI for us-west-2, which matches
# the GPU_ZONE and GPU_TYPE defaults above. Deploying in another region requires that
# region's AMI ID — see the AMI table in the deployment guide.
# These AMIs are private; see the guide for requesting access, or build your own with
# ./ami/build-ami.sh.
AMI_ID=ami-0a7bcd77b90558f9c
