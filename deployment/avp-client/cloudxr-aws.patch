+
+//
+// CLOUDXR-AWS: entire file added.
+//
+// Obtains a Cognito ID token for the self-hosted CloudXR-on-AWS proxy, so the operator no
+// longer has to mint a JWT out of band and paste it into the app. The token is presented on
+// the signaling upgrade as `Authorization: Bearer <idToken>`; the proxy verifies it and never
+// issues tokens itself, so nothing server-side changes to support this.
+//
+// Deliberately has no AWS SDK dependency. The app client has no client secret, so
+// `InitiateAuth` needs neither SigV4 signing nor a SECRET_HASH — it is a plain unsigned
+// HTTPS POST that URLSession can make directly.
+//
+// The refresh token is kept in the Keychain, not in UserDefaults: `@AppStorage` writes
+// plaintext into the preferences plist, and that store also proved unreliable to reason about
+// (the simulator's cfprefsd serves a cached copy that survives direct plist edits). The
+// password is never persisted anywhere.
+//
+
+import Foundation
+import Security
+import OSLog
+
+/// CLOUDXR-AWS: deployment-specific defaults, so a fresh install needs only credentials.
+///
+/// This is the single place to change when pointing the viewer at a different CloudXR-on-AWS
+/// deployment. `setup-avp-client.sh --domain <your-domain>` rewrites it for you; edit it here if
+/// you are wiring the project up by hand.
+enum CloudXRAWSDefaults {
+    /// Hostname that terminates native signaling. This is the ALB (`origin.<domain>`), not the
+    /// CloudFront apex, because CloudXRKit compiles the signaling port in as 48322 and CloudFront
+    /// serves viewer traffic only on 80/443. `CloudXRAWSAuth` derives the apex from this name to
+    /// locate `config.json`, which CloudFront does serve.
+    ///
+    /// Matches the `NativeSignalingHost` output of the CloudFormation stack.
+    static let signalingHost = "origin.cloudxr.example.com"
+}
+
+/// Failure modes of the CloudXR-on-AWS sign-in path, phrased for display in the config UI.
+enum CloudXRAWSAuthError: LocalizedError {
+    case configUnavailable(tried: String, underlying: String)
+    case missingCredentials
+    case invalidCredentials
+    case challengeRequired(String)
+    case malformedResponse
+    case service(type: String, message: String)
+
+    var errorDescription: String? {
+        switch self {
+        case .configUnavailable(let tried, let underlying):
+            return "Couldn't load deployment config (tried \(tried)): \(underlying)"
+        case .missingCredentials:
+            return "Enter a username and password."
+        case .invalidCredentials:
+            return "Incorrect username or password."
+        case .challengeRequired(let name):
+            return "Sign-in needs an additional step this app doesn't handle yet (\(name))."
+        case .malformedResponse:
+            return "Unexpected response from Cognito."
+        case .service(let type, let message):
+            return "Cognito error \(type): \(message)"
+        }
+    }
+}
+
+/// The subset of `/config.json` this app needs. Written by `deploy.sh` at deploy time and
+/// served from S3 via CloudFront — the same file the web client reads before its own login.
+private struct CloudXRAWSDeploymentConfig: Decodable {
+    let region: String
+    let userPoolId: String
+    let clientId: String
+    let apiEndpoint: String
+}
+
+struct CloudXRAWSAuth {
+
+    private static let logger = Logger(
+        subsystem: Bundle.main.bundleIdentifier ?? "com.nvidia.cloudxr-viewer",
+        category: "CloudXRAWSAuth"
+    )
+
+    private static let keychainService = "com.nvidia.cloudxr-viewer.cloudxr-aws"
+    private static let refreshTokenAccount = "cognitoRefreshToken"
+
+    // MARK: - Public surface
+
+    /// True when a refresh token is stored, meaning sign-in can proceed without a password.
+    static var hasStoredSession: Bool {
+        readRefreshToken() != nil
+    }
+
+    /// Discards the stored refresh token, forcing a full password sign-in next time.
+    static func signOut() {
+        deleteRefreshToken()
+        logger.info("Cleared stored CloudXR-on-AWS session")
+    }
+
+    /// Returns a Cognito ID token suitable for the signaling `Authorization` header.
+    ///
+    /// Prefers a silent refresh when a refresh token is stored, and falls back to a
+    /// username/password exchange. On a successful password exchange the refresh token is
+    /// stored so subsequent connects need no password.
+    ///
+    /// - Parameter signalingHost: the proxy host entered in the UI. Used to locate the
+    ///   deployment's `config.json`; see `loadConfig(signalingHost:)`.
+    static func idToken(
+        signalingHost: String,
+        username: String,
+        password: String
+    ) async throws -> String {
+        let config = try await loadConfig(signalingHost: signalingHost)
+
+        if let stored = readRefreshToken() {
+            do {
+                let response = try await initiateAuth(region: config.region, payload: [
+                    "AuthFlow": "REFRESH_TOKEN_AUTH",
+                    "ClientId": config.clientId,
+                    "AuthParameters": ["REFRESH_TOKEN": stored]
+                ])
+                let tokens = try extractTokens(from: response)
+                logger.info("Signed in via stored refresh token")
+                return tokens.idToken
+            } catch {
+                // A refresh token can be revoked or aged out (30 days by default). Drop it and
+                // fall through to the password path rather than failing the whole connect.
+                logger.warning("Refresh token rejected, falling back to password: \(error.localizedDescription, privacy: .public)")
+                deleteRefreshToken()
+            }
+        }
+
+        let user = username.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard !user.isEmpty, !password.isEmpty else {
+            throw CloudXRAWSAuthError.missingCredentials
+        }
+
+        let response = try await initiateAuth(region: config.region, payload: [
+            "AuthFlow": "USER_PASSWORD_AUTH",
+            "ClientId": config.clientId,
+            "AuthParameters": ["USERNAME": user, "PASSWORD": password]
+        ])
+        let tokens = try extractTokens(from: response)
+
+        if let refresh = tokens.refreshToken {
+            storeRefreshToken(refresh)
+            logger.info("Signed in with password; refresh token stored")
+        } else {
+            logger.info("Signed in with password; no refresh token returned")
+        }
+        return tokens.idToken
+    }
+
+    // MARK: - Deployment config
+
+    /// Fetches `config.json` for the deployment.
+    ///
+    /// The file is intentionally *not* in the proxy container image — `.dockerignore` excludes
+    /// it so Cognito IDs are not baked into a build, and `deploy.sh` uploads it to S3 where
+    /// CloudFront serves it from the apex domain. The signaling host, by contrast, is the ALB
+    /// (`origin.<domain>`), because the native client's hardcoded 48322 cannot traverse
+    /// CloudFront. So the apex is tried first by dropping a leading `origin.` label, then the
+    /// signaling host itself as a fallback for topologies that serve both from one name.
+    private static func loadConfig(signalingHost: String) async throws -> CloudXRAWSDeploymentConfig {
+        var candidates: [String] = []
+        let originPrefix = "origin."
+        if signalingHost.hasPrefix(originPrefix) {
+            candidates.append(String(signalingHost.dropFirst(originPrefix.count)))
+        }
+        candidates.append(signalingHost)
+
+        var lastError = "no reachable host"
+        for host in candidates {
+            guard let url = URL(string: "https://\(host)/config.json") else { continue }
+            do {
+                let (data, response) = try await URLSession.shared.data(from: url)
+                guard let http = response as? HTTPURLResponse else {
+                    lastError = "\(host): no HTTP response"
+                    continue
+                }
+                guard http.statusCode == 200 else {
+                    lastError = "\(host): HTTP \(http.statusCode)"
+                    continue
+                }
+                let config = try JSONDecoder().decode(CloudXRAWSDeploymentConfig.self, from: data)
+                logger.info("Loaded deployment config from \(host, privacy: .public) (region \(config.region, privacy: .public))")
+                return config
+            } catch {
+                lastError = "\(host): \(error.localizedDescription)"
+            }
+        }
+        throw CloudXRAWSAuthError.configUnavailable(
+            tried: candidates.joined(separator: ", "),
+            underlying: lastError
+        )
+    }
+
+    // MARK: - Cognito
+
+    /// Unsigned `InitiateAuth` call against the regional Cognito IDP endpoint.
+    private static func initiateAuth(
+        region: String,
+        payload: [String: Any]
+    ) async throws -> [String: Any] {
+        guard let url = URL(string: "https://cognito-idp.\(region).amazonaws.com/") else {
+            throw CloudXRAWSAuthError.malformedResponse
+        }
+
+        var request = URLRequest(url: url)
+        request.httpMethod = "POST"
+        request.setValue("application/x-amz-json-1.1", forHTTPHeaderField: "Content-Type")
+        request.setValue(
+            "AWSCognitoIdentityProviderService.InitiateAuth",
+            forHTTPHeaderField: "X-Amz-Target"
+        )
+        request.httpBody = try JSONSerialization.data(withJSONObject: payload)
+
+        let (data, response) = try await URLSession.shared.data(for: request)
+
+        guard let http = response as? HTTPURLResponse,
+              let json = try? JSONSerialization.jsonObject(with: data) as? [String: Any] else {
+            throw CloudXRAWSAuthError.malformedResponse
+        }
+
+        guard http.statusCode == 200 else {
+            let type = (json["__type"] as? String) ?? "Unknown"
+            let message = (json["message"] as? String) ?? (json["Message"] as? String) ?? "no message"
+            if type.contains("NotAuthorized") || type.contains("UserNotFound") {
+                throw CloudXRAWSAuthError.invalidCredentials
+            }
+            throw CloudXRAWSAuthError.service(type: type, message: message)
+        }
+
+        return json
+    }
+
+    private static func extractTokens(
+        from json: [String: Any]
+    ) throws -> (idToken: String, refreshToken: String?) {
+        // MFA or a forced password change comes back as a challenge instead of tokens. Nothing
+        // in the current pool enables one, but fail clearly rather than crash if that changes.
+        if let challenge = json["ChallengeName"] as? String {
+            throw CloudXRAWSAuthError.challengeRequired(challenge)
+        }
+        guard let result = json["AuthenticationResult"] as? [String: Any],
+              let idToken = result["IdToken"] as? String else {
+            throw CloudXRAWSAuthError.malformedResponse
+        }
+        // REFRESH_TOKEN_AUTH reuses the existing refresh token and returns none.
+        return (idToken, result["RefreshToken"] as? String)
+    }
+
+    // MARK: - Keychain
+
+    private static func baseQuery() -> [String: Any] {
+        [
+            kSecClass as String: kSecClassGenericPassword,
+            kSecAttrService as String: keychainService,
+            kSecAttrAccount as String: refreshTokenAccount
+        ]
+    }
+
+    private static func storeRefreshToken(_ token: String) {
+        guard let data = token.data(using: .utf8) else { return }
+        SecItemDelete(baseQuery() as CFDictionary)
+
+        var attributes = baseQuery()
+        attributes[kSecValueData as String] = data
+        attributes[kSecAttrAccessible as String] = kSecAttrAccessibleAfterFirstUnlock
+
+        let status = SecItemAdd(attributes as CFDictionary, nil)
+        if status != errSecSuccess {
+            logger.error("Keychain write failed with status \(status)")
+        }
+    }
+
+    private static func readRefreshToken() -> String? {
+        var query = baseQuery()
+        query[kSecReturnData as String] = true
+        query[kSecMatchLimit as String] = kSecMatchLimitOne
+
+        var item: CFTypeRef?
+        let status = SecItemCopyMatching(query as CFDictionary, &item)
+        guard status == errSecSuccess,
+              let data = item as? Data,
+              let token = String(data: data, encoding: .utf8),
+              !token.isEmpty else {
+            return nil
+        }
+        return token
+    }
+
+    private static func deleteRefreshToken() {
+        let status = SecItemDelete(baseQuery() as CFDictionary)
+        if status != errSecSuccess && status != errSecItemNotFound {
+            logger.error("Keychain delete failed with status \(status)")
+        }
+    }
+}
